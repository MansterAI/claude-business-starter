# ════════════════════════════════════════════════════════════
#  Fichier OPTIONNEL. Tu n'en as pas besoin pour démarrer :
#  ta connexion Pilora suffit, y compris pour tes KPIs.
#  Copie-le en « .env » seulement si tu veux l'auto-sync ci-dessous.
#  Le .env n'est JAMAIS poussé sur GitHub (protégé par .gitignore).
# ════════════════════════════════════════════════════════════

# ── Auto-sync avancé (Meta Ads + GoHighLevel) ───────────────────
# À remplir seulement si tu veux que la skill tire tes chiffres
# automatiquement au lieu de te les demander.

# Meta Ads : System User token avec la permission « ads_read »
META_ACCESS_TOKEN=
# Format act_XXXXXXXXXXXX (Business Manager → Comptes publicitaires)
META_AD_ACCOUNT_ID=

# GoHighLevel : clé API (Settings → Business → API Key, ou Private Integration)
GHL_API_KEY=
# ID de ta location GHL (Settings → Company)
GHL_LOCATION_ID=
